[Unit]
Description=Healthchecks database cleanup
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User={{ healthchecks_user }}
Group={{ healthchecks_group }}
WorkingDirectory={{ healthchecks_src_dir }}
EnvironmentFile={{ healthchecks_env_file }}
Environment=PYTHONPATH={{ healthchecks_python_lib_dir }}
ExecStart={{ healthchecks_python }} manage.py pruneusers
ExecStart={{ healthchecks_python }} manage.py prunetokenbucket
ExecStart={{ healthchecks_python }} manage.py pruneobjects
