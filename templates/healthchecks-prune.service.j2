[Unit]
Description=Healthchecks database cleanup
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User={{ healthchecks_user }}
Group={{ healthchecks_group }}
WorkingDirectory={{ healthchecks_src_dir }}
EnvironmentFile={{ healthchecks_env_file }}
ExecStart={{ healthchecks_venv_dir }}/bin/python {{ healthchecks_src_dir }}/manage.py pruneusers
ExecStart={{ healthchecks_venv_dir }}/bin/python {{ healthchecks_src_dir }}/manage.py prunetokenbucket
ExecStart={{ healthchecks_venv_dir }}/bin/python {{ healthchecks_src_dir }}/manage.py pruneobjects
