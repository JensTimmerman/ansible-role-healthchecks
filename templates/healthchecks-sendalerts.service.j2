[Unit]
Description=Healthchecks alert sender
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User={{ healthchecks_user }}
Group={{ healthchecks_group }}
WorkingDirectory={{ healthchecks_src_dir }}
EnvironmentFile={{ healthchecks_env_file }}
Environment=PYTHONPATH={{ healthchecks_python_lib_dir }}
ExecStart={{ healthchecks_python }} manage.py sendalerts --skip-checks
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
