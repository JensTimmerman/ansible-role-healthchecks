[Unit]
Description=Healthchecks web
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User={{ healthchecks_user }}
Group={{ healthchecks_group }}
WorkingDirectory={{ healthchecks_src_dir }}
EnvironmentFile={{ healthchecks_env_file }}
Environment=PYTHONPATH={{ healthchecks_python_lib_dir }}
ExecStart={{ healthchecks_python }} -m gunicorn \
    --bind {{ healthchecks_gunicorn_bind }} \
    --workers {{ healthchecks_gunicorn_workers }} \
    --timeout {{ healthchecks_gunicorn_timeout }} \
    hc.wsgi:application
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
