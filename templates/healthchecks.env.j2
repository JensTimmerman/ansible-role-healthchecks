# {{ ansible_managed }}
DEBUG=False
SECRET_KEY="{{ healthchecks_secret_key }}"
SITE_ROOT="{{ healthchecks_site_root }}"
SITE_NAME="{{ healthchecks_site_name }}"
ALLOWED_HOSTS="{{ healthchecks_allowed_hosts | join(',') }}"
SECURE_PROXY_SSL_HEADER="HTTP_X_FORWARDED_PROTO,https"

DB={{ 'postgres' if healthchecks_db_engine == 'postgresql' else healthchecks_db_engine }}
DB_NAME="{{ healthchecks_db_name }}"
{% if healthchecks_db_engine == 'postgresql' %}
DB_USER="{{ healthchecks_db_user }}"
DB_PASSWORD="{{ healthchecks_db_password }}"
DB_HOST="{{ healthchecks_db_host }}"
DB_PORT="{{ healthchecks_db_port }}"
{% endif %}

DEFAULT_FROM_EMAIL="{{ healthchecks_default_from_email }}"
EMAIL_HOST="{{ healthchecks_email_host }}"
EMAIL_PORT="{{ healthchecks_email_port }}"
EMAIL_USE_TLS={{ healthchecks_email_use_tls | bool | ternary('True', 'False') }}
EMAIL_USE_SSL={{ healthchecks_email_use_ssl | bool | ternary('True', 'False') }}
EMAIL_USE_VERIFICATION={{ healthchecks_email_use_verification | bool | ternary('True', 'False') }}
{% if healthchecks_email_user | length > 0 %}
EMAIL_HOST_USER="{{ healthchecks_email_user }}"
{% endif %}
{% if healthchecks_email_password | length > 0 %}
EMAIL_HOST_PASSWORD="{{ healthchecks_email_password }}"
{% endif %}

REGISTRATION_OPEN={{ healthchecks_registration_open | bool | ternary('True', 'False') }}
USE_PAYMENTS={{ healthchecks_use_payments | bool | ternary('True', 'False') }}
APPRISE_ENABLED={{ healthchecks_apprise_enabled | bool | ternary('True', 'False') }}
PROMETHEUS_ENABLED={{ healthchecks_prometheus_enabled | bool | ternary('True', 'False') }}
